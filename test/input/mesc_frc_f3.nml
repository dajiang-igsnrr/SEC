&mesc
    ! Run mode: 1-4 (selects which case-specific input is used).
    runcase = 2

    ! Model options.
    jglobal = .true.        ! Global output
    kinetics = 3            ! 1: forward MM; 2: reverse MM; 3: MES-C
    bgcopt = 3              ! Biogeochemical type to simulate
    jopt = .false.          ! .false.: forward simulation; .true.: SCE-UA optimisation
    jrestart = 0            ! 0: cold start; 1: read frestart_in
    jmodel = 1              ! 1: CABLE; 2: ORCHIDEE
    use_modis_npp = .false. ! .true.: rescale ORCHIDEE NPP and carbon inputs using MODIS NPP

    ! Common files.
    frestart_in  = 'miccpool_in.nc'
    frestart_out = 'miccpool_out.nc'
    foutput      = 'vmic_output.nc'
    fparameter   = 'parameters.txt'

    ! SOC-fraction simulation (runcase=2).
    ifsoc14  = 0      ! 0: exclude C-14; 1: include C-14
    frac14c=''        ! input data for running 14c
    f14c(1)=''        ! atmospheric 14C data in NH1
    f14c(2)=''        ! atmospheric 14C data in NH2
    f14c(3)=''        ! atmospheric 14C data in NH3
    f14c(4)=''        ! atmospheric 14C data in SH1&2
    f14c(5)=''        ! atmospheric 14C data in SH3
    cfraction = './input/c_fraction01_new_xclaysilt_test.nc'

    ! HWSD SOC-profile simulation (runcase=3).
    fhwsdsoc = './input/data_extraction_cable_model_calibration_cluster_test.nc'
    fmodis   = './input/MODIS_npp_2001-2009_cable.nc'
    fanoc    = './input/fanoc_mp_100_matched_sites.nc'

    ! Global simulation (runcase=4).
    fglobal(1) = ''
    fglobal(2) = ''
    fglobal(3) = ''
    fglobal(4) = ''
    fglobal(5) = ''
    fglobal(6) = ''
    fglobal(7) = ''
/
